{
	"name": "stack-dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"cf:deploy": "wrangler deploy --env=\"\"",
		"cf:deploy:preview": "pnpm run build && wrangler deploy --env preview",
		"cf:dev": "pnpm run build && wrangler dev -c wrangler.local.jsonc --local-protocol http",
		"cf:dev:remote": "pnpm run build && wrangler dev --remote",
		"check": "svelte-kit sync && GOMAXPROCS=2 svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && GOMAXPROCS=2 svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api --watch",
		"dev": "vite dev",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"test:accessibility": "playwright test",
		"test:accessibility:ci": "playwright install --with-deps chrome && playwright test"
	},
	"dependencies": {
		"@better-auth/core": "^1.7.16",
		"@better-auth/passkey": "^1.7.16",
		"@better-auth/utils": "^0.5.1",
		"@plausible-analytics/tracker": "^0.4.5",
		"@sentry/sveltekit": "11.8.0",
		"arktype": "^2.2.3",
		"posthog-js": "1.434.2",
		"posthog-node": "^5.52.4",
		"qrcode": "^1.5.4",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.0",
		"@cloudflare/workers-types": "^5.20261002.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@iconify-json/lucide": "^1.2.117",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@internationalized/date": "^3.12.2",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"@types/qrcode": "^1.5.6",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"better-auth": "^1.7.16",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.19",
		"shadcn-svelte": "^1.4.2",
		"stack-backend": "workspace:*",
		"stack-shared": "workspace:*",
		"svelte": "^5.56.6",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.1.5",
		"wrangler": "catalog:"
	}
}
