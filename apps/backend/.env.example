# DATABASE CONNECTION STRING
# yes, it has a dumb name, blame cloudflare
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://postgres:mysecretpassword@127.0.0.1:5432/postgres"

# Better Auth
# For production use 32+ characters generated with high entropy
# https://www.better-auth.com/docs/installation
# In development, it doesn't really matter.
BETTER_AUTH_SECRET=""

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# VyOS (plain-HTTP proxy from dev/compose.yaml)
VYOS_API_URL="http://127.0.0.1:18443"
VYOS_API_KEY="vyos-dev"

# Bunny.net DNS (reverse DNS / PTR records)
# When unset, PTR record management is disabled and rDNS controls are read-only.
BUNNY_API_KEY=""

# Email
# If these variables aren't filled out, it will print it in console instead.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_EMAIL_API_TOKEN=""

# Autumn billing
# Optional in local dev: when AUTUMN_ENABLED="false" or AUTUMN_SECRET is unset,
# billing is disabled and billing state is treated as active.
AUTUMN_ENABLED="false"
AUTUMN_SECRET=""

# Proxmox VE (plain-HTTP proxy from dev/compose.yaml)
PROXMOX_API_URL="http://127.0.0.1:18006"
PROXMOX_TOKEN_ID="root@pam!stack"
PROXMOX_TOKEN_SECRET="" # printed by dev/pve/init-cluster.sh
PROXMOX_API_SECRET=""
PROXMOX_VM_FIREWALL_SECURITY_GROUP="stack-dev"
# VM CPU model. Unset defaults to x86-64-v4, which needs AVX-512 on the host.
PROXMOX_VM_CPU_TYPE=""
# Comma-separated Proxmox node names that must never receive new VMs, even if
# the cluster reports them online. Nodes in HA maintenance or fence state are
# skipped automatically.
PROXMOX_EXCLUDED_NODES=""

PROXMOX_SNIPPETS_ENDPOINT_URL="http://127.0.0.1:8005"
PROXMOX_SNIPPETS_ENDPOINT_USERNAME="dev"
PROXMOX_SNIPPETS_ENDPOINT_PASSWORD="dev"
PROXMOX_SNIPPETS_STORAGE="stack-volumes"

STACK_TIMING_SPAM=""
