{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "stack-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-05",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"ORIGIN": "http://localhost:5173",
		"EMAIL_FROM_ADDRESS": "no-reply@example.com",
		"EMAIL_FROM_NAME": "Fyra Stack",
		"EMAIL_REPLY_TO": "support@example.com",
		"AUTUMN_DEFAULT_PLAN_ID": "stack",
		"AUTUMN_SERVER_ENTITY_FEATURE_ID": "vms",
		"AUTUMN_CREDITS_FEATURE_ID": "credits",
		"VYOS_USE_VPC": "false",
		"PROXMOX_USE_VPC": "false",
		"PROXMOX_SNIPPETS_USE_VPC": "false",
		"BILLING_DISABLED": "false"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "25228ed6f77e49fb8041aed12879327d"
		}
	],
	"workflows": [
		{
			"name": "stack-vm-deletion",
			"binding": "VM_DELETION",
			"class_name": "VmDeletion"
		},
		{
			"name": "stack-vm-provisioning",
			"binding": "VM_PROVISIONING",
			"class_name": "VmProvisioning"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SERIAL_CONSOLE",
				"class_name": "SerialConsoleSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-serial-console",
			"new_sqlite_classes": ["SerialConsoleSession"]
		}
	],
	"kv_namespaces": [
		{
			"binding": "FEATURE_FLAGS",
			"id": "0ad17de8747747bca1975d473e66e295"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	]
}
