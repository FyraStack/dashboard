{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "stack-dashboard",
	"account_id": "b5233d7eddf19b9902e2afab0a73ac11",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-04-05",
	"compatibility_flags": ["nodejs_compat"],
	"minify": true,
	"routes": [
		{
			"pattern": "dash.fyrastack.com",
			"custom_domain": true
		}
	],
	"vars": {
		"PUBLIC_POSTHOG_KEY": "phc_xpPsXXeqca5GUtozk5DvUdTFMwAjYN7z4SDYLHSqwHpX",
		"PUBLIC_POSTHOG_HOST": "https://us.posthog.com",
		"PUBLIC_SENTRY_DSN": "https://509fc8298796e65c16acbef704256178@o271654.ingest.us.sentry.io/4512122021412864"
	},
	"services": [
		{
			"binding": "BACKEND",
			"service": "stack-backend"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"run_worker_first": [
			"/",
			"/_app/remote/*",
			"/internal/*",
			"/api/*",
			"/admin/*",
			"/projects/*",
			"/login*",
			"/register*",
			"/signup*",
			"/accept-invitation/*"
		]
	},
	"placement": {
		"mode": "targeted",
		"region": "azure:northcentralus"
	},
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"destinations": ["sentry-traces"]
		},
		"logs": {
			"enabled": true,
			"persist": true,
			"destinations": ["sentry-logs"]
		}
	},
	"env": {
		"preview": {
			"minify": true,
			"vars": {
				"PUBLIC_POSTHOG_KEY": "phc_xpPsXXeqca5GUtozk5DvUdTFMwAjYN7z4SDYLHSqwHpX",
				"PUBLIC_POSTHOG_HOST": "https://us.posthog.com",
				"PUBLIC_SENTRY_DSN": "https://509fc8298796e65c16acbef704256178@o271654.ingest.us.sentry.io/4512122021412864",
				"STACK_TIMING_SPAM": "true"
			},
			"services": [
				{
					"binding": "BACKEND",
					"service": "stack-backend-preview"
				}
			],
			"placement": {
				"mode": "targeted",
				"region": "azure:northcentralus"
			},
			"observability": {
				"enabled": true,
				"issues": {
					"enabled": true
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 1,
					"destinations": ["stack-otlp-traces"]
				},
				"logs": {
					"enabled": true,
					"destinations": ["stack-otlp-logs"]
				}
			}
		}
	}
}
